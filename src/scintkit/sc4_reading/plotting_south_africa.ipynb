from pathlib import Path
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

# Folder containing lvl3 parquet files
data_dir = Path("/home/dal674840/scratch/20240629")      # <-- change if needed
output_dir = data_dir / "plots"
output_dir.mkdir(exist_ok=True)

CONST_COLORS = {
    "GPS": "tab:blue",
    "GAL": "tab:red",
    "BDS": "tab:green",
    "GLO": "tab:purple",
    "SBAS": "tab:orange",
}

# Loop over every lvl3 parquet file
for pq_file in sorted(data_dir.glob("*_lvl3.pq")):

    print(f"Processing {pq_file.name}")

    df = pd.read_parquet(pq_file)

    if len(df) == 0:
        continue

    # -------------------------
    # Create figure
    # -------------------------
    fig, (ax1, ax2) = plt.subplots(
        2,
        1,
        figsize=(18,8),
        sharex=True,
        constrained_layout=True,
    )

    # -------------------------
    # Plot each constellation
    # -------------------------
    for cons in sorted(df["cons"].dropna().unique()):

        cons_df = df[df["cons"] == cons]
        color = CONST_COLORS.get(cons, "black")

        for sat in sorted(cons_df["satellite"].unique()):

            sat_df = (
                cons_df[cons_df["satellite"] == sat]
                .sort_values("minbin")
                .copy()
            )

            # Sigma-phi interpolation
            if "sigma_phi_1" in sat_df.columns:

                sat_df["sigma_phi_1_plot"] = sat_df["sigma_phi_1"]

                if "quality_1" in sat_df.columns:
                    sat_df.loc[
                        sat_df["quality_1"] != 0,
                        "sigma_phi_1_plot"
                    ] = np.nan

                sat_df["sigma_phi_1_plot"] = (
                    sat_df["sigma_phi_1_plot"]
                    .interpolate(limit_direction="both")
                )

            if "sigma_phi_2" in sat_df.columns:

                sat_df["sigma_phi_2_plot"] = sat_df["sigma_phi_2"]

                if "quality_2" in sat_df.columns:
                    sat_df.loc[
                        sat_df["quality_2"] != 0,
                        "sigma_phi_2_plot"
                    ] = np.nan

                sat_df["sigma_phi_2_plot"] = (
                    sat_df["sigma_phi_2_plot"]
                    .interpolate(limit_direction="both")
                )

            # S4
            ax1.scatter(
                sat_df["minbin"],
                sat_df["s4_1"],
                color=color,
                marker="o",
                s=6,
                alpha=0.5,
            )

            ax1.scatter(
                sat_df["minbin"],
                sat_df["s4_2"],
                color=color,
                marker="s",
                s=6,
                alpha=0.5,
            )

            # Sigma-phi
            if cons != "GLO":

                ax2.scatter(
                    sat_df["minbin"],
                    sat_df["sigma_phi_1_plot"],
                    color=color,
                    marker="^",
                    s=6,
                    alpha=0.5,
                )

                ax2.scatter(
                    sat_df["minbin"],
                    sat_df["sigma_phi_2_plot"],
                    color=color,
                    marker="v",
                    s=6,
                    alpha=0.5,
                )

    # -------------------------
    # Formatting
    # -------------------------
    ax1.set_ylabel("S4")
    ax1.set_ylim(0,1.5)
    ax1.grid(True, linestyle="--", alpha=0.4)

    ax2.set_ylabel(r"$\sigma_\phi$ (rad)")
    ax2.set_xlabel("UTC")
    ax2.set_ylim(0,1.5)
    ax2.grid(True, linestyle="--", alpha=0.4)

    start = pd.Timestamp(df["minbin"].min().floor("D"))
    end = start + pd.Timedelta(days=1)

    locator = mdates.HourLocator(interval=1)
    formatter = mdates.DateFormatter("%H:%M")

    for ax in (ax1, ax2):
        ax.set_xlim(start, end)
        ax.xaxis.set_major_locator(locator)
        ax.xaxis.set_major_formatter(formatter)

    plt.setp(ax2.get_xticklabels(), rotation=45)

    handles = [
        plt.Line2D([], [], color="tab:blue", marker="o", linestyle="", label="GPS"),
        plt.Line2D([], [], color="tab:red", marker="o", linestyle="", label="GAL"),
        plt.Line2D([], [], color="tab:green", marker="o", linestyle="", label="BDS"),
        plt.Line2D([], [], color="tab:purple", marker="o", linestyle="", label="GLO"),
        plt.Line2D([], [], color="tab:orange", marker="o", linestyle="", label="SBAS"),
    ]

    fig.legend(
        handles=handles,
        loc="upper right",
        ncol=2,
        frameon=True,
    )

    fig.suptitle(
        pq_file.stem,
        fontsize=16,
        fontweight="bold",
    )

    plt.savefig(
        output_dir / f"{pq_file.stem}_S4_sigma_phi.png",
        dpi=300,
        bbox_inches="tight",
    )

    plt.close(fig)

print("Done!")
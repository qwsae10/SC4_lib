from pathlib import Path
import shutil
import subprocess as sp

def binary_to_clean_txt(binary_file, output_dir=None, keep_raw_txt=False, overwrite=False):
    #Method to convert Scintpi binary files to cleaned txt files.

    binary_file = Path(binary_file).resolve()

    if not binary_file.exists():
        raise FileNotFoundError(binary_file)
    
    if output_dir is None:
        output_dir = Path.cwd()
    output_dir = Path(output_dir).resolve()
    working_binary = output_dir / binary_file.name

    if not working_binary.exists():
        shutil.copy2(binary_file, working_binary)    

    commands = ["rxtools_exec.sh", "bin2asc", "-f", working_binary.name, "--extractGenMeas"]
    result = sp.run(commands, capture_output=True, text=True, cwd=output_dir)
    print("RXTools finished.")
    if result.returncode != 0:
        raise RuntimeError(f"Error occurred while converting {working_binary} to text: {result.stderr}")
    
    print(result.stdout)
    print(result.stderr)

    txt_files = list(
    output_dir.glob(
        f"{working_binary.name}*measurements.txt"
    )
)
    if not txt_files:
        raise FileNotFoundError(
        "No measurements file produced by RXTools"
    )

    measurement_file = txt_files[0]

    clean_file = measurement_file.with_name(
    measurement_file.stem + "_F.txt"
    )
    with open(measurement_file, "r") as fin, open(clean_file, "w") as fout:
        for line in fin:
            if "Error" in line:
                continue
            if ",," in line:
                continue
            fout.write(line)

    return clean_file

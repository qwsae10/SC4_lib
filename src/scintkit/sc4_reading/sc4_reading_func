from pathlib import Path
import subprocess as sp

def binary_to_clean_txt(binary_file, output_dir=None, keep_raw_txt=False, overwrite=False):
    #Method to convert Scintpi binary files to cleaned txt files.

    binary_file = Path(binary_file).resolve()

    if not binary_file.exists():
        raise FileNotFoundError(binary_file)
    if output_dir is None:
        output_dir = binary_file.parent
    commands = ["rxtools_exec.sh", "bin2asc", "-f",str(binary_file), "--extractGenMeas"]
    result = sp.run(commands, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"Error occurred while converting {binary_file} to text: {result.stderr}")
    return result.stdout
    print(result.stdout)
    print(result.stderr)

